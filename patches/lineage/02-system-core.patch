diff --git a/init/ril_property_audit.cpp b/init/ril_property_audit.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0be2d788d433f23392c7398e464717d7e81c1398
--- /dev/null
+++ b/init/ril_property_audit.cpp
@@ -0,0 +1,189 @@
+#include "ril_property_audit.h"
+
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <new>
+
+namespace android::init::ril_audit {
+namespace {
+
+static_assert(__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__);
+static_assert(sizeof(pid_t) == 4 && sizeof(uid_t) == 4);
+static_assert(__atomic_always_lock_free(sizeof(uint32_t), nullptr));
+
+constexpr uint32_t kCapacityFlag = 1;
+constexpr uint32_t kFieldFlag = 2;
+constexpr uint32_t kClockFlag = 4;
+constexpr uint32_t kExhaustedFlag = 8;
+constexpr uint32_t kMax = std::numeric_limits<uint32_t>::max();
+
+struct Header {
+    char magic[8];
+    uint32_t version;
+    uint32_t header_bytes;
+    uint32_t record_bytes;
+    uint32_t capacity;
+    uint32_t sequence;
+    uint32_t records;
+    uint32_t attempts;
+    uint32_t duplicates;
+    uint32_t dropped;
+    uint32_t flags;
+    uint8_t reserved[16];
+};
+
+struct Row {
+    int32_t pid;
+    uint32_t uid;
+    uint64_t boottime_ns;
+    char name[256];
+    char target[256];
+    uint8_t reserved[112];
+};
+
+static_assert(sizeof(Header) == Writer::kHeaderBytes && alignof(Header) == 4);
+static_assert(offsetof(Header, magic) == 0 && offsetof(Header, version) == 8);
+static_assert(offsetof(Header, header_bytes) == 12 && offsetof(Header, record_bytes) == 16);
+static_assert(offsetof(Header, capacity) == 20 && offsetof(Header, sequence) == 24);
+static_assert(offsetof(Header, records) == 28 && offsetof(Header, attempts) == 32);
+static_assert(offsetof(Header, duplicates) == 36 && offsetof(Header, dropped) == 40);
+static_assert(offsetof(Header, flags) == 44 && offsetof(Header, reserved) == 48);
+static_assert(sizeof(Row) == Writer::kRecordBytes && alignof(Row) == 8);
+static_assert(offsetof(Row, pid) == 0 && offsetof(Row, uid) == 4);
+static_assert(offsetof(Row, boottime_ns) == 8 && offsetof(Row, name) == 16);
+static_assert(offsetof(Row, target) == 272 && offsetof(Row, reserved) == 528);
+
+class ErrnoGuard {
+  public:
+    ErrnoGuard() : saved_(errno) {}
+    ~ErrnoGuard() { errno = saved_; }
+
+  private:
+    int saved_;
+};
+
+bool ValidField(const char* value, bool target) {
+    if (value == nullptr || value[0] == '\0') return false;
+    for (size_t index = 0; index < 256; ++index) {
+        unsigned char character = value[index];
+        if (character == 0) return true;
+        if (!((character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') ||
+              (character >= '0' && character <= '9') || character == '_' || character == '.' ||
+              character == '-' || character == ':' || (!target && character == '@') ||
+              (target && character == ','))) {
+            return false;
+        }
+    }
+    return false;
+}
+
+void Increment(uint32_t& counter, Header& header) {
+    if (counter != kMax) ++counter;
+    if (counter == kMax) header.flags |= kExhaustedFlag;
+}
+
+}
+
+Writer::~Writer() {
+    ErrnoGuard guard;
+    if (mapping_ != nullptr) munmap(mapping_, kFileBytes);
+}
+
+bool Writer::Initialize(int fd) {
+    ErrnoGuard guard;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (attempted_) return false;
+    attempted_ = true;
+    struct stat st {};
+    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_nlink != 1 ||
+        (st.st_mode & 07777) != 0600 || st.st_uid != geteuid() || st.st_size != 0) {
+        return false;
+    }
+    if (ftruncate(fd, kFileBytes) != 0) return false;
+    void* mapping = mmap(nullptr, kFileBytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (mapping == MAP_FAILED) return false;
+    auto* header = new (mapping) Header{};
+    __atomic_store_n(&header->sequence, 1, __ATOMIC_SEQ_CST);
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    memcpy(header->magic, "RILSET1", sizeof(header->magic));
+    header->version = 1;
+    header->header_bytes = kHeaderBytes;
+    header->record_bytes = kRecordBytes;
+    header->capacity = kCapacity;
+    __atomic_store_n(&header->sequence, 2, __ATOMIC_RELEASE);
+    mapping_ = mapping;
+    return true;
+}
+
+void Writer::Record(const char* source, const char* name, const char* target, pid_t pid,
+                    uid_t uid) noexcept {
+    ErrnoGuard guard;
+    if (source == nullptr || strncmp(source, "u:r:rild:s0", sizeof("u:r:rild:s0")) != 0) {
+        return;
+    }
+    bool scoped = name != nullptr &&
+                  (strncmp(name, "vendor.", 7) == 0 ||
+                   strncmp(name, "persist.vendor.", 15) == 0 ||
+                   strncmp(name, "ro.vendor.", 10) == 0);
+    if (name != nullptr && !scoped) return;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mapping_ == nullptr || exhausted_) return;
+    auto& header = *static_cast<Header*>(mapping_);
+    uint32_t sequence = __atomic_load_n(&header.sequence, __ATOMIC_ACQUIRE);
+    __atomic_store_n(&header.sequence, sequence + 1, __ATOMIC_SEQ_CST);
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    if (scoped) Increment(header.attempts, header);
+    if (sequence >= kMax - 3) {
+        header.flags |= kExhaustedFlag;
+        Increment(header.dropped, header);
+        exhausted_ = true;
+    } else {
+        if (!ValidField(name, false) || !ValidField(target, true)) {
+            Increment(header.dropped, header);
+            header.flags |= kFieldFlag;
+        } else {
+            auto* rows = reinterpret_cast<Row*>(static_cast<char*>(mapping_) + kHeaderBytes);
+            bool duplicate = false;
+            for (uint32_t index = 0; index < header.records; ++index) {
+                if (rows[index].pid == pid && rows[index].uid == uid &&
+                    strcmp(rows[index].name, name) == 0 && strcmp(rows[index].target, target) == 0) {
+                    duplicate = true;
+                    break;
+                }
+            }
+            if (duplicate) {
+                Increment(header.duplicates, header);
+            } else if (header.records == kCapacity) {
+                Increment(header.dropped, header);
+                header.flags |= kCapacityFlag;
+            } else {
+                struct timespec now {};
+                if (clock_gettime(CLOCK_BOOTTIME, &now) != 0 || now.tv_sec < 0 ||
+                    now.tv_nsec < 0 || now.tv_nsec >= 1000000000 ||
+                    static_cast<uint64_t>(now.tv_sec) >
+                            (UINT64_MAX - static_cast<uint64_t>(now.tv_nsec)) / 1000000000) {
+                    Increment(header.dropped, header);
+                    header.flags |= kClockFlag;
+                } else {
+                    auto& row = *new (&rows[header.records]) Row{};
+                    row.pid = pid;
+                    row.uid = uid;
+                    row.boottime_ns = static_cast<uint64_t>(now.tv_sec) * 1000000000 + now.tv_nsec;
+                    memcpy(row.name, name, strlen(name) + 1);
+                    memcpy(row.target, target, strlen(target) + 1);
+                    ++header.records;
+                }
+            }
+        }
+    }
+    __atomic_store_n(&header.sequence, sequence + 2, __ATOMIC_RELEASE);
+}
+
+}
diff --git a/init/ril_property_audit.h b/init/ril_property_audit.h
new file mode 100644
index 0000000000000000000000000000000000000000..651f17f1e22c2d2a4845e1d7d30643b6bbf0f989
--- /dev/null
+++ b/init/ril_property_audit.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <sys/types.h>
+
+#include <cstddef>
+#include <mutex>
+
+namespace android::init::ril_audit {
+
+class Writer {
+  public:
+    static constexpr size_t kCapacity = 512;
+    static constexpr size_t kHeaderBytes = 64;
+    static constexpr size_t kRecordBytes = 640;
+    static constexpr size_t kFileBytes = kHeaderBytes + kCapacity * kRecordBytes;
+
+    Writer() = default;
+    ~Writer();
+    Writer(const Writer&) = delete;
+    Writer& operator=(const Writer&) = delete;
+
+    bool Initialize(int fd);
+    void Record(const char* source, const char* name, const char* target, pid_t pid,
+                uid_t uid) noexcept;
+
+  private:
+    std::mutex mutex_;
+    void* mapping_ = nullptr;
+    bool attempted_ = false;
+    bool exhausted_ = false;
+};
+
+}
