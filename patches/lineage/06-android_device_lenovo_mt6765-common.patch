+    'zOi3amkQaMQ2PAAAe3tXnKwZopkAAccQrDkAAPEVX4OxxGf7AgAAAAAEWVo='
+)
+PATCHES = ((0x1F0, OLD_EXIDX, NEW_EXIDX),
+           (OFFSET, bytes.fromhex('f0b587b0'), AFTER))
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def transform(blob):
+    if sha(blob) != INPUT_SHA256:
+        raise ValueError('Unsupported nvram_daemon SHA256')
+    if blob[0x6050:0x6054] != bytes.fromhex('fd360000'):
+        raise ValueError('Unexpected worker table entry')
+    if sha(blob[0x73FE:0x7C6A]) != OLD_DEBUG_SHA256:
+        raise ValueError('Unexpected compressed debug metadata')
+    changed = bytearray(blob)
+    for offset, old, new in PATCHES:
+        if blob[offset:offset + len(old)] != old or len(old) != len(new):
+            raise ValueError('Unexpected reviewed allocation')
+        changed[offset:offset + len(old)] = new
+    changed[0x73FE:0x7C6A] = NEW_DEBUG
+    if len(changed) != len(blob) or sha(changed) != OUTPUT_SHA256:
+        raise ValueError('Generated output SHA256 mismatch')
+    return bytes(changed)
+
+
+def absolute(path):
+    # Do not resolve symlinks away before checking them.
+    return Path(os.path.abspath(path))
+
+
+def directory(path, *, create=False, output=False):
+    """Walk with NOFOLLOW dirfds; reject symlink ancestors and source outputs."""
+    path = absolute(path)
+    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        parts = path.parts[1:]
+        for index in range(len(parts) + 1):
+            if output:
+                try:
+                    os.stat('.git', dir_fd=fd, follow_symlinks=False)
+                except FileNotFoundError:
+                    pass
+                else:
+                    raise ValueError('Output has a .git ancestor (including files/symlinks)')
+                # Android's multi-repository source root is not itself a git repo.
+                try:
+                    os.stat('.repo', dir_fd=fd, follow_symlinks=False)
+                except FileNotFoundError:
+                    pass
+                else:
+                    if index == len(parts) or parts[index] != 'out':
+                        raise ValueError('Output inside Android sources is forbidden; use out/')
+            if index == len(parts):
+                return fd
+            name = parts[index]
+            try:
+                next_fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
+            except FileNotFoundError:
+                if not create:
+                    raise
+                os.mkdir(name, 0o755, dir_fd=fd)
+                next_fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
+            os.close(fd)
+            fd = next_fd
+    except BaseException:
+        os.close(fd)
+        raise
+
+
+def read_input(path):
+    path = absolute(path)
+    parent = directory(path.parent)
+    try:
+        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
+        with os.fdopen(fd, 'rb') as stream:
+            identity = os.fstat(stream.fileno())
+            if not stat.S_ISREG(identity.st_mode) or identity.st_nlink != 1:
+                raise ValueError('Input must be a regular file with one link')
+            return stream.read(), identity
+    finally:
+        os.close(parent)
+
+
+def write_candidate(input_path, output_path, data, identity, generated_root=None):
+    output = absolute(output_path)
+    if output == absolute(input_path):
+        raise ValueError('Refusing to overwrite input')
+    if generated_root is not None:
+        root = absolute(generated_root)
+        if root.parent.name != 'lenovo-proinfo-probe-migration' or output != root / 'nvram_daemon':
+            raise ValueError('Replacement requires exact dedicated generated-root/nvram_daemon')
+    parent = directory(output.parent, create=True, output=True)
+    temporary = '.nvram_daemon.' + secrets.token_hex(16)
+    try:
+        try:
+            existing = os.stat(output.name, dir_fd=parent, follow_symlinks=False)
+        except FileNotFoundError:
+            existing = None
+        if existing is not None:
+            if (existing.st_dev, existing.st_ino) == (identity.st_dev, identity.st_ino):
+                raise ValueError('Refusing input hardlink')
+            if not stat.S_ISREG(existing.st_mode) or existing.st_nlink != 1:
+                raise ValueError('Output must not be a symlink, hardlink or special file')
+            if generated_root is None:
+                raise FileExistsError('Output already exists; exclusive creation is the default')
+            old_fd = os.open(output.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent)
+            with os.fdopen(old_fd, 'rb') as old:
+                if sha(old.read()) != OUTPUT_SHA256:
+                    raise ValueError('Replacement target is not the pinned generated output')
+        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent)
+        with os.fdopen(fd, 'wb') as stream:
+            stream.write(data)
+            stream.flush()
+            os.fchmod(stream.fileno(), 0o755)
+            os.fsync(stream.fileno())
+        if generated_root is None:
+            # Atomic publish without overwriting even if a target appears meanwhile.
+            os.link(temporary, output.name, src_dir_fd=parent, dst_dir_fd=parent, follow_symlinks=False)
+        else:
+            os.replace(temporary, output.name, src_dir_fd=parent, dst_dir_fd=parent)
+        os.fsync(parent)
+    finally:
+        try:
+            os.unlink(temporary, dir_fd=parent)
+        except FileNotFoundError:
+            pass
+        os.close(parent)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('input', type=Path)
+    parser.add_argument('--output', type=Path)
+    parser.add_argument('--replace-generated', action='store_true')
+    parser.add_argument('--generated-root', type=Path)
+    args = parser.parse_args()
+    if args.replace_generated != (args.generated_root is not None) or (args.replace_generated and args.output is None):
+        parser.error('--replace-generated requires --generated-root and --output together')
+    try:
+        original, identity = read_input(args.input)
+        changed = transform(original)
+        if args.output is not None:
+            write_candidate(args.input, args.output, changed, identity, args.generated_root)
+    except (OSError, ValueError) as error:
+        print('Error:', error, file=sys.stderr)
+        return 2
+    print(json.dumps({'input_sha256': INPUT_SHA256, 'r1_sha256': R1_SHA256,
+                      'output_sha256': OUTPUT_SHA256, 'size': len(changed),
+                      'code_range': [0x36FC, 0x3700], 'exidx_word_range': [0x1F4, 0x1F8],
+                      'debug_allocation': [0x73FE, 0x7C6A], 'installed': False}, indent=2))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/tools/ril_property_trace.py b/tools/ril_property_trace.py
new file mode 100644
index 0000000000000000000000000000000000000000..030bb7ace6d0c462f90d12c9ea0e56ac73975e63
--- /dev/null
+++ b/tools/ril_property_trace.py
@@ -0,0 +1,83 @@
+import re
+import struct
+
+
+SINK_PATH = "/dev/lineage_ril_property_audit"
+MAGIC = b"RILSET1\0"
+HEADER_BYTES = 64
+RECORD_BYTES = 640
+CAPACITY = 512
+FILE_BYTES = HEADER_BYTES + RECORD_BYTES * CAPACITY
+SOURCE_CONTEXT = "u:r:rild:s0"
+HEADER = struct.Struct("<8s14I")
+RECORD = struct.Struct("<iIQ256s256s112s")
+NAME = re.compile(r"(?:vendor\.|persist\.vendor\.|ro\.vendor\.)[A-Za-z0-9_.:@-]+\Z")
+CONTEXT = re.compile(r"u:object_r:[A-Za-z0-9_]+:s0\Z")
+
+
+class TraceError(ValueError):
+    pass
+
+
+class UnstableSnapshot(TraceError):
+    pass
+
+
+def header(data):
+    if len(data) != FILE_BYTES:
+        raise TraceError("Unexpected RIL trace size: " + str(len(data)))
+    fields = HEADER.unpack_from(data)
+    magic, version, header_bytes, record_bytes, capacity = fields[:5]
+    if (magic, version, header_bytes, record_bytes, capacity) != (MAGIC, 1, HEADER_BYTES, RECORD_BYTES, CAPACITY):
+        raise TraceError("Unsupported RIL trace schema")
+    sequence, records, attempts, duplicates, dropped, flags = fields[5:11]
+    if any(fields[11:]) or flags & ~15 or records > CAPACITY:
+        raise TraceError("Invalid RIL trace header")
+    if sequence % 2:
+        raise UnstableSnapshot("RIL trace writer is active")
+    return sequence, records, attempts, duplicates, dropped, flags
+
+
+def c_string(data):
+    end = data.find(b"\0")
+    if end < 0 or any(data[end:]):
+        raise TraceError("Invalid RIL trace string padding")
+    try:
+        return data[:end].decode("ascii")
+    except UnicodeDecodeError as error:
+        raise TraceError("Non-ASCII RIL trace field") from error
+
+
+def parse_pair(first, second):
+    first_header = header(first)
+    second_header = header(second)
+    if first_header != second_header or first[:HEADER_BYTES] != second[:HEADER_BYTES]:
+        raise UnstableSnapshot("RIL trace changed between snapshots")
+    sequence, count, attempts, duplicates, dropped, flags = first_header
+    if not flags & (2 | 8) and attempts != count + duplicates + dropped:
+        raise TraceError("Inconsistent RIL trace counters")
+    records = []
+    keys = set()
+    for index in range(count):
+        pid, uid, boottime_ns, name_bytes, context_bytes, reserved = RECORD.unpack_from(
+            first, HEADER_BYTES + index * RECORD_BYTES)
+        name = c_string(name_bytes)
+        context = c_string(context_bytes)
+        if pid <= 0 or not NAME.fullmatch(name) or not CONTEXT.fullmatch(context) or any(reserved):
+            raise TraceError("Invalid RIL trace record " + str(index))
+        key = (pid, uid, name, context)
+        if key in keys:
+            raise TraceError("Duplicate RIL trace record")
+        keys.add(key)
+        records.append({"pid": pid, "uid": uid, "boottime_ns": boottime_ns,
+                        "name": name, "source_context": SOURCE_CONTEXT, "target_context": context})
+    if any(first[HEADER_BYTES + count * RECORD_BYTES:]):
+        raise TraceError("Unexpected data outside committed RIL trace records")
+    return {"schema_version": 1, "status": "captured", "snapshot_consistent": True,
+            "phase": "before_mac", "source_context": SOURCE_CONTEXT,
+            "record_semantics": "first_seen_per_pid_uid_name_context",
+            "exhaustive": False, "sequence": sequence, "capacity": CAPACITY,
+            "attempts": attempts, "duplicates": duplicates, "dropped": dropped,
+            "flags": flags, "counters_stopped": bool(flags & 8), "truncated": bool(flags),
+            "records": records,
+            "caveat": "Attempt names only; neither policy decisions nor successful writes. Workload coverage is not established."}
diff --git a/tools/selinux_inventory.py b/tools/selinux_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..c9aaf8c7ef05a21c01ba09c873fa0c7c07fc3748
--- /dev/null
+++ b/tools/selinux_inventory.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+sys.dont_write_bytecode = True
+import device_audit
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def read_optional(path):
+    return path.read_text(errors="replace") if path.exists() else ""
+
+
+def add_entry(inventory, source, name, context, capture):
+    entry = inventory.setdefault((source, name), {"source": source, "name": name,
+                                                 "contexts": set(), "captures": set()})
+    entry["contexts"].add(context)
+    entry["captures"].add(capture)
+
+
+def publish(inventory):
+    return [{**entry, "contexts": sorted(entry["contexts"]), "captures": sorted(entry["captures"])}
+            for key, entry in sorted(inventory.items())]
+
+
+def inventory_captures(captures):
+    summaries = []
+    reports = {}
+    setters = {}
+    lookups = {}
+    for directory in sorted(captures.iterdir()):
+        log = directory / "logcat.txt"
+        original_path = directory / "report.json"
+        if not directory.is_dir() or not log.is_file() or not original_path.is_file():
+            continue
+        original = json.loads(original_path.read_text())
+        processes = directory / "processes.txt"
+        hal = directory / "hal.txt"
+        window = directory / "capture-window.json"
+        inputs = [path for path in [log, original_path, processes, hal, window] if path.is_file()]
+        before = {str(path.resolve()): digest(path) for path in inputs}
+        report = device_audit.analyze(log.read_text(errors="replace"),
+                                      read_optional(processes), read_optional(hal))
+        if window.exists():
+            report["capture_window"] = json.loads(window.read_text())
+        report["marker_timing"] = {
+            "loss": device_audit.marker_timing(report["loss_markers"], report.get("capture_window")),
+            "crash": device_audit.marker_timing(report["crash_markers"], report.get("capture_window")),
+        }
+        report["original_snapshot_metadata"] = {
+            key: original[key] for key in ["collection", "selinux", "properties", "warnings",
+                                           "interface_snapshots", "codec_library_files", "display_library_files"]
+            if key in original
+        }
+        report["input_sha256"] = before
+        after = {str(path.resolve()): digest(path) for path in inputs}
+        if before != after:
+            raise ValueError("Capture changed during analysis: " + str(directory))
+        reports[directory.name] = report
+        summaries.append({
+            "capture": directory.name,
+            "source": str(directory.resolve()),
+            "previous_lookup_records": original.get("property_lookup_records"),
+            "lookup_records": report["property_lookup_records"],
+            "lookup_names": report["property_lookup_names"],
+            "raw_avc_records": report["raw_avc_records"],
+            "distinct_signatures": report["distinct_signatures"],
+            "input_sha256": before,
+        })
+        for case in report["object_cases"]:
+            source, target, kind, command, permissions, object_name = case["key"]
+            if kind == "property_service" and "set" in permissions.split() and object_name.startswith("property:"):
+                add_entry(setters, source, object_name[len("property:"):], target, directory.name)
+        for lookup in report["property_lookups"]:
+            process = lookup["process_at_snapshot"]
+            source = process["context"] if process else "unattributed"
+            add_entry(lookups, source, lookup["name"], lookup["context"], directory.name)
+    if not summaries:
+        raise ValueError("No completed captures found in " + str(captures))
+    return summaries, reports, publish(setters), publish(lookups)
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Offline SELinux inventory; never connects to a device.")
+    parser.add_argument("--captures", type=Path, default=Path("out/device-audits"))
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    try:
+        summaries, reports, setters, lookups = inventory_captures(args.captures)
+        latest = summaries[-1]
+        limitations = [
+            "Lookups are not setter evidence, denied accesses or proof a property exists.",
+            "Lookup source domains come from process snapshots; PID reuse and exited processes remain ambiguous.",
+            "Setter names come from explicit AVCs; AVC caching/rate limits mean this is not a complete attempt trace.",
+            "Repeated captures of one boot and duplicate log lines are not independent fixes or failures.",
+            "Original snapshot warnings/health are preserved as historical metadata, not newly measured.",
+            "Missing markers or accesses do not prove a workload ran or that Enforcing is ready.",
+        ]
+        result = {"schema_version": 1, "offline_only": True, "captures": summaries,
+                  "latest_capture": latest["capture"], "setter_avc_inventory": setters,
+                  "lookup_inventory_snapshot_attribution": lookups, "limitations": limitations,
+                  "analyzer_sha256": digest(Path(device_audit.__file__)),
+                  "inventory_tool_sha256": digest(Path(__file__))}
+        lines = ["# Offline SELinux inventory", "", "No device commands or ROM builds were run.", "",
+                 "Captures: " + str(len(summaries)), "Latest: " + latest["capture"],
+                 "Latest property records: {} -> {}".format(latest["previous_lookup_records"], latest["lookup_records"]),
+                 "Latest distinct lookup names: " + str(latest["lookup_names"]), "",
+                 "## Explicit RIL setter AVC names across captures", ""]
+        lines += ["- `" + entry["name"] + "`" for entry in setters if entry["source"] == "u:r:rild:s0"]
+        lines += ["", "## Limits", ""] + ["- " + limit for limit in limitations]
+        args.output.mkdir(parents=True, exist_ok=False)
+        reanalysis = args.output / "reanalysis"
+        reanalysis.mkdir()
+        for name, report in reports.items():
+            (reanalysis / (name + ".json")).write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n")
+        (args.output / "inventory.json").write_text(json.dumps(result, indent=2, ensure_ascii=False) + "\n")
+        (args.output / "inventory.md").write_text("\n".join(lines) + "\n")
+        print("Analyzed {} captures; latest: {} records / {} lookup names".format(
+            len(summaries), latest["lookup_records"], latest["lookup_names"]))
+        print("Output: " + str(args.output))
+        return 0
+    except (OSError, ValueError, KeyError) as error:
+        print("Error: " + str(error))
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
