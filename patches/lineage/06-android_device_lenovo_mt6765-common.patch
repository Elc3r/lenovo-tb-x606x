new file mode 100644
index 0000000000000000000000000000000000000000..8c32ac21a2d26ad5482edde32444d408515d13f0
--- /dev/null
+++ b/tools/validate_boot_migrations.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Recompute reviewed boot migrations for staged-image and OTA validation.
+
+No device interaction, generated-file replacement, or Android build is performed.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[4]
+COMMON = ROOT / 'device/lenovo/mt6765-common'
+VENDOR = ROOT / 'vendor/lenovo/mt6765-common/proprietary/vendor'
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def expected_payloads():
+    """Only the reviewed, product-selected transformations belong here."""
+    graphics = load('boot_graphics_migration', COMMON / 'graphics-storage/migrate.py')
+    original = (VENDOR / 'lib64/egl/libGLES_meow.so').read_bytes()
+    result = graphics.migrate(original)
+    logger = load('boot_logger_migration', COMMON / 'tools/prepare_modem_logger_migration.py')
+    modem, evidence = logger.prepare((VENDOR / 'bin/ccci_mdinit').read_bytes())
+    proinfo = load('boot_proinfo_migration', COMMON / 'tools/prepare_proinfo_probe_migration.py')
+    nvram = proinfo.transform((VENDOR / 'bin/nvram_daemon').read_bytes())
+    camera = load('camera_storage_migration', COMMON / 'camera-storage/migrate.py')
+    stereo = camera.migrate((VENDOR / 'lib64/libstereoinfoaccessor_vsdof.so').read_bytes())
+    config = load('camera_config_migration', COMMON / 'camera-config/migrate.py')
+    configurations = {'lib64/' + name: config.migrate((VENDOR / 'lib64' / name).read_bytes(), name)
+                      for name in config.LIBRARIES}
+    ecm = load('ecm_consumer_migration', COMMON / 'ecm-consumer/migrate.py')
+    configurations['lib64/libmtk-ril.so'] = ecm.migrate((VENDOR / 'lib64/libmtk-ril.so').read_bytes())
+    return {**configurations, 'lib64/egl/libGLES_meow.so': result,
+            'bin/ccci_mdinit': modem, 'bin/nvram_daemon': nvram,
+            'lib64/libstereoinfoaccessor_vsdof.so': stereo}
+
+
+def verify_reader(read_file):
+    """read_file takes a vendor-relative path and returns payload bytes."""
+    identities = {}
+    for relative, expected in expected_payloads().items():
+        actual = read_file(relative)
+        if actual != expected:
+            raise ValueError('Packaged boot migration differs: ' + relative)
+        identities['vendor/' + relative] = hashlib.sha256(actual).hexdigest()
+    return identities
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--product-out', type=Path, required=True)
+    args = parser.parse_args()
+    identities = verify_reader(lambda name: (args.product_out / 'vendor' / name).read_bytes())
+    print(json.dumps(identities, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/validate_ecm_export.py b/tools/validate_ecm_export.py
new file mode 100644
index 0000000000000000000000000000000000000000..f0b3507514977dc719147ae1b6761cc1bac8cb05
--- /dev/null
+++ b/tools/validate_ecm_export.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Read-only ELF and init payload checks for the fixed ECM export."""
+import hashlib
+from pathlib import Path
+import shutil
+import subprocess
+
+SYMBOLS = ('__system_property_set_ecm_snapshot', '__system_property_initialize_ecm_snapshot')
+INIT_MARKERS = (
+    b'ECM publisher initialization failed; RIL startup remains blocked',
+    b'ECM publisher is not ready; RIL startup remains blocked',
+    b'ECM snapshot storage preparation failed',
+    b'ECM snapshot is published only by its canonical transaction',
+)
+
+
+def verify_symbols(path):
+    readelf = shutil.which('readelf')
+    if not readelf:
+        raise ValueError('Host readelf is required to check private ECM symbols')
+    result = subprocess.run([readelf, '--dyn-syms', '--wide', str(path)],
+                            capture_output=True, text=True, check=True, timeout=30)
+    identities = {}
+    for symbol in SYMBOLS:
+        records = [line.split() for line in result.stdout.splitlines()
+                   if line.split() and line.split()[-1].split('@')[0] == symbol]
+        if (len(records) != 1 or len(records[0]) < 8 or records[0][6] == 'UND'
+                or records[0][4] not in {'GLOBAL', 'WEAK'}
+                or records[0][-1] != symbol + '@@LIBC_PRIVATE'):
+            raise ValueError('Missing/incorrect private ECM symbol: ' + symbol)
+        identities[symbol] = records[0][-1]
+    return identities
+
+
+def verify_runtime(read_runtime_file, read_init, directory):
+    identities = {}
+    for architecture, relative in [('arm', 'lib/bionic/libc.so'), ('arm64', 'lib64/bionic/libc.so')]:
+        data = read_runtime_file(relative)
+        path = Path(directory) / ('ecm-' + architecture + '-libc.so')
+        path.write_bytes(data)
+        identities[architecture] = verify_symbols(path)
+        identities[architecture]['sha256'] = hashlib.sha256(data).hexdigest()
+    init = read_init()
+    for marker in INIT_MARKERS:
+        if marker not in init:
+            raise ValueError('Missing init ECM publisher/gate marker: ' + marker.decode())
+    return {'ecm_private_runtime_symbols': identities, 'ecm_init_publisher_and_gate_markers': True}
diff --git a/tools/validate_keymaster.py b/tools/validate_keymaster.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e29195592b6f67ca4caeea9a4173aea3c4f832b
--- /dev/null
+++ b/tools/validate_keymaster.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import tempfile
+import zipfile
+
+
+EXPECTED_SHA256 = "ac5bf57b05d791d900589d3786289077ac9ed666eae4af9f6101c734242a38a0"
+SERVICE = "android.hardware.keymaster@4.0-service"
+VENDOR_BYTES = 838860800
+BLOCK_BYTES = 4096
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def check_service(content):
+    require(hashlib.sha256(content).hexdigest() == EXPECTED_SHA256,
+            "Keymaster is not the pinned stock Beanpod executable")
+    require(content[:6] == b"\x7fELF\x02\x01" and struct.unpack_from("<H", content, 18)[0] == 183,
+            "Expected an ARM64 little-endian ELF")
+
+
+def check_ota(path, expected_rc, brotli):
+    with zipfile.ZipFile(path) as archive, tempfile.TemporaryDirectory(prefix="keymaster-ota-") as temporary:
+        require(archive.testzip() is None, "OTA ZIP integrity check failed")
+        script = archive.read("META-INF/com/google/android/updater-script").decode()
+        require('getprop("ro.product.device") == "achilles6_row_data"' in script,
+                "Unexpected OTA device assertion")
+        require('"vendor.new.dat.br"' in script, "Expected a full vendor block OTA")
+        transfer = archive.read("vendor.transfer.list").decode().splitlines()
+        require(len(transfer) >= 4 and transfer[0] == "4", "Expected transfer-list version 4")
+        require(transfer[2:4] == ["0", "0"], "Incremental/stashed OTA is not supported")
+        commands = []
+        new_bytes = 0
+        for line in transfer[4:]:
+            command, encoded_ranges = line.split()
+            require(command in ["new", "zero", "erase"], f"Unsupported OTA command: {command}")
+            ranges = [int(value) for value in encoded_ranges.split(",")]
+            require(ranges[0] == len(ranges) - 1 and ranges[0] % 2 == 0,
+                    "Malformed OTA block ranges")
+            for start, end in zip(ranges[1::2], ranges[2::2]):
+                require(0 <= start < end <= VENDOR_BYTES // BLOCK_BYTES,
+                        "OTA range exceeds the configured vendor partition")
+                if command == "new":
+                    commands.append((start * BLOCK_BYTES, (end - start) * BLOCK_BYTES))
+                    new_bytes += (end - start) * BLOCK_BYTES
+        directory = Path(temporary)
+        compressed = directory / "vendor.new.dat.br"
+        with archive.open("vendor.new.dat.br") as source, compressed.open("wb") as destination:
+            shutil.copyfileobj(source, destination)
+        decompressed = directory / "vendor.new.dat"
+        subprocess.run([brotli, "-d", "-o", str(decompressed), str(compressed)], check=True)
+        require(decompressed.stat().st_size == new_bytes, "Unexpected decompressed vendor data size")
+        image = directory / "vendor.raw.img"
+        with image.open("w+b") as destination, decompressed.open("rb") as source:
+            destination.truncate(VENDOR_BYTES)
+            for offset, length in commands:
+                destination.seek(offset)
+                remaining = length
+                while remaining:
+                    chunk = source.read(min(remaining, 1024 * 1024))
+                    require(chunk, "Truncated vendor block data")
+                    destination.write(chunk)
+                    remaining -= len(chunk)
+        for filename, expected in [(f"/bin/hw/{SERVICE}", None),
+                                   (f"/etc/init/{SERVICE}.rc", expected_rc)]:
+            result = subprocess.run(["debugfs", "-R", f"cat {filename}", str(image)],
+                                    check=True, capture_output=True)
+            if expected is None:
+                check_service(result.stdout)
+            else:
+                require(result.stdout == expected, "OTA Keymaster init configuration differs from source")
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--product-out", type=Path)
+    parser.add_argument("--ota", type=Path)
+    parser.add_argument("--brotli", default="brotli")
+    args = parser.parse_args()
+    device = Path(__file__).resolve().parents[1]
+    blob = device / "keymaster" / (SERVICE + ".beanpod")
+    check_service(blob.read_bytes())
+    expected_rc = (device / "keymaster" / (SERVICE + ".rc")).read_bytes()
+    require(f"service vendor.keymaster-4-0 /vendor/bin/hw/{SERVICE}".encode() in expected_rc,
+            "Unexpected init service path")
+    require(b"interface android.hardware.keymaster@4.0::IKeymasterDevice default" in expected_rc,
+            "Missing Keymaster HAL interface declaration")
+    product = (device / "mt6765.mk").read_text()
+    require("    android.hardware.keymaster@4.0-service \\\n" not in product,
+            "Software Keymaster is still explicitly packaged")
+    require(f"keymaster/{SERVICE}.beanpod:$(TARGET_COPY_OUT_VENDOR)/bin/hw/{SERVICE}" in product,
+            "Missing hardware Keymaster copy rule")
+    if args.product_out:
+        vendor = args.product_out / "vendor"
+        check_service((vendor / "bin/hw" / SERVICE).read_bytes())
+        require((vendor / "etc/init" / (SERVICE + ".rc")).read_bytes() == expected_rc,
+                "Built Keymaster init configuration differs from source")
+    if args.ota:
+        check_ota(args.ota, expected_rc, args.brotli)
+    print(json.dumps({"source_service_sha256": EXPECTED_SHA256,
+                      "source_configuration_checked": True,
+                      "product_out": str(args.product_out.resolve()) if args.product_out else None,
+                      "ota": str(args.ota.resolve()) if args.ota else None,
+                      "built_vendor_checked": args.product_out is not None,
+                      "ota_vendor_payload_checked": args.ota is not None,
+                      "hardware_security_level_verified_on_device": False}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
