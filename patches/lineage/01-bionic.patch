diff --git a/libc/system_properties/include/system_properties/ecm_export_coordinator.h b/libc/system_properties/include/system_properties/ecm_export_coordinator.h
new file mode 100644
index 0000000000000000000000000000000000000000..eac865a419ae5fbc2a383423192c14cd27dff44a
--- /dev/null
+++ b/libc/system_properties/include/system_properties/ecm_export_coordinator.h
@@ -0,0 +1,108 @@
+// Fixed ECM snapshot coordinator. Caller must own all property-area mutations.
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace ecm_export {
+// Bionic builds without C++ standard-library headers. Used only in unevaluated contexts.
+template <class T> T&& Declval() noexcept;
+inline constexpr char kCanonical[] = "ril.cdma.inecmmode";
+inline constexpr char kAlias[] = "sys.radio.ecm_v1";
+inline constexpr size_t kCapacity = 92;  // Must static_assert against PROP_VALUE_MAX in Bionic.
+
+// The low 24 bits are a mutable update counter, including bit16. is_long()
+// interprets that bit as a flag ONLY for ro.* properties, never these fixed keys.
+inline constexpr bool ValidMutableSerial(uint32_t serial) noexcept {
+  return !(serial & 1u) && (serial >> 24) < kCapacity;
+}
+
+struct Value {
+  char bytes[kCapacity]{};
+  size_t size = 0;
+
+  // Input retains embedded NUL. Canonical Add and Update have different old semantics.
+  bool Assign(const char* data, size_t length) noexcept {
+    if (length >= kCapacity || (length && !data)) return false;
+    if (length) ::memcpy(bytes, data, length);
+    bytes[length] = 0;
+    size = length;
+    return true;
+  }
+  // Canonical Update may retain old bytes, including a nonzero byte at [length].
+  // Snapshot exact storage; never infer length with strlen or coerce its terminator.
+  void CopyStored(const char* data, size_t length) noexcept {
+    ::memcpy(bytes, data, length + 1);
+    size = length;
+  }
+  bool operator==(const Value& other) const noexcept {
+    return size == other.size && ::memcmp(bytes, other.bytes, size) == 0;
+  }
+};
+
+enum class Target { Canonical, Alias };
+enum class Status { Ok, Unhandled, AliasRejected, InvalidValue, StorageError };
+struct Result {
+  Status status;
+  bool alias_changed = false;
+  Value stored{};  // Actual canonical declared payload for post-commit notifications.
+};
+
+// Backend contract (NOT established by mock tests):
+// * The caller holds the SAME all-mutator lock across this entire call and notifications.
+// * No context reset, remap, AreaInit, Init/ResetAccess, or direct mutator may interleave.
+// * Snapshot reads canonical, never alias. Missing canonical is represented by empty Value.
+// * ReserveAlias initializes absent/existing alias to old canonical bytes; any error leaves
+//   canonical unchanged. It may leave alias reserved/reconciled to old bytes on later failure.
+// * PrepareUpdate pins the actual prop_info, matching area, serial area, and length; no mutation.
+// * PrepareAdd pins canonical area/serial area and validates name/length before AddCanonical.
+// * AddCanonical failure occurs before publishing canonical prop_info/value (trie allocation
+//   may be consumed). Success publishes the requested bytes, with no fallible step remaining.
+// * CommitCanonical preserves old strlcpy Update semantics, then copies actual storage into next.
+// * Commit is a VOID noexcept exact length+1 copy for alias. No lookup,
+//   allocation, callback, validation, logging, rollback, exceptions, or recoverable failure.
+// * Plans are transaction-local; no reuse after releasing the lock or resetting contexts.
+template <class Backend>
+Result Store(Backend& storage, const char* key, const char* data, size_t length) noexcept {
+  static_assert(__is_same(decltype(Declval<Backend&>().Commit(
+      Declval<const typename Backend::Plan&>(), Declval<const Value&>())), void));
+  static_assert(noexcept(Declval<Backend&>().Commit(
+      Declval<const typename Backend::Plan&>(), Declval<const Value&>())));
+  static_assert(__is_same(decltype(Declval<Backend&>().CommitCanonical(
+      Declval<const typename Backend::Plan&>(), Declval<Value&>())), void));
+  static_assert(noexcept(Declval<Backend&>().CommitCanonical(
+      Declval<const typename Backend::Plan&>(), Declval<Value&>())));
+  if (::strcmp(key, kAlias) == 0) return {Status::AliasRejected};
+  if (::strcmp(key, kCanonical) != 0) return {Status::Unhandled};
+  Value next;
+  if (!next.Assign(data, length)) return {Status::InvalidValue};
+  Value old;
+  bool exists = false;
+  bool reserved_changed = false;
+  typename Backend::Plan source{}, alias{};
+  if (!storage.Snapshot(old, exists) || !storage.ReserveAlias(old, reserved_changed) ||
+      !storage.PrepareUpdate(Target::Alias, next, alias)) return {Status::StorageError};
+  if (exists) {
+    if (!storage.PrepareUpdate(Target::Canonical, next, source)) return {Status::StorageError};
+    // ALL fallible operations precede the first canonical byte change.
+    storage.CommitCanonical(source, next);
+  } else {
+    if (!storage.PrepareAdd(next, source) || !storage.AddCanonical(source, next))
+      return {Status::StorageError};
+    // Add published canonical. No lookup/preflight/fallible Update is permitted from here.
+  }
+  storage.Commit(alias, next);
+  return {Status::Ok, reserved_changed || !(old == next), next};
+}
+
+// Invoke under the same all-mutator lock, AFTER Store returns, before acknowledgement.
+// Sink must enqueue in order without re-entering any property mutator. Production service
+// retains its existing canonical notifications (including identical writes).
+template <class Sink>
+void Notify(const Result& result, bool active, Sink& sink) noexcept {
+  if (result.status != Status::Ok || !active) return;
+  sink.Canonical(result.stored);
+  if (result.alias_changed) sink.Alias(result.stored);
+}
+}  // namespace ecm_export
