+#include "system_properties/vt_property_audit.h"
+
+#if defined(LINEAGE_PROPERTY_AUDIT)
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+
+#include <async_safe/log.h>
+
+#include "private/ErrnoRestorer.h"
+
+bool IsVtPropertyAuditTarget() {
+  ErrnoRestorer errno_restorer;
+  const char* program = getprogname();
+  if (program != nullptr && strcmp(program, "vtservice") == 0) return true;
+  if (program != nullptr && strcmp(program, "<unknown>") != 0) return false;
+  char thread_name[16] = {};
+  return prctl(PR_GET_NAME, thread_name) == 0 && strcmp(thread_name, "vtservice") == 0;
+}
+
+void TraceVtPropertyRoute(VtPropertyAuditOperation operation) {
+  ErrnoRestorer errno_restorer;
+  if (!IsVtPropertyAuditTarget()) return;
+  static const char* const operations[] = {
+      "serialized_init", "named_lookup", "foreach", "reset_access", "named_vendor_open",
+      "foreach_vendor", "reset_vendor", "vendor_check", "vendor_open",
+  };
+  const auto index = static_cast<unsigned int>(operation);
+  if (index >= sizeof(operations) / sizeof(operations[0])) return;
+  static atomic_uint reported = 0;
+  const unsigned int mask = 1u << index;
+  if ((atomic_fetch_or_explicit(&reported, mask, memory_order_relaxed) & mask) != 0) return;
+  const char* enabled = getenv("LINEAGE_PROPERTY_AUDIT");
+  const bool environment_enabled = enabled != nullptr && strcmp(enabled, "1") == 0;
+  const char* environment = enabled == nullptr ? "absent" : environment_enabled ? "enabled" : "disabled";
+  const char* context = index >= static_cast<unsigned int>(VtPropertyAuditOperation::NamedVendorOpen)
+                            ? "u:object_r:vendor_default_prop:s0"
+                            : "none";
+  async_safe_format_log(ANDROID_LOG_INFO, "property_route",
+                        "route operation=%s context=%s env=%s scope=process_selector limit=9",
+                        operations[index], context, environment);
+}
+#endif
